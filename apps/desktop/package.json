{
  "name": "@sound-spatializer/desktop",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-mediapipe-build.mjs",
    "preview": "vite preview",
    "package": "tauri build --no-bundle --features custom-protocol --config src-tauri/tauri.production.conf.json && powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/Stage-DesktopRuntime.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/Test-TauriArtifact.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b",
    "assets:sync": "node scripts/sync-mediapipe-assets.mjs",
    "icon:generate": "node scripts/generate-icon.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
