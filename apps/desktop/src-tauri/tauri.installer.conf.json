{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "devUrl": null
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Sound Spatializer",
    "shortDescription": "Spatialisation binaurale dynamique pour Windows",
    "longDescription": "Rendu binaural HRTF avec suivi de tête, spatialisation par fenêtre et profils SADIE II embarqués.",
    "resources": {
      "resources/hrtf": "hrtf",
      "resources/engine": "engine"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
