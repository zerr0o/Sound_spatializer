{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-spatializer.local/contracts/window-spatialization-v1.schema.json",
  "title": "WindowSpatializationConfigV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enabled",
    "maxSources",
    "stereoSpread",
    "followWindowPosition",
    "displayCalibrations",
    "sourceRules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "maxSources": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "stereoSpread": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.72
    },
    "emitterPlacementMode": {
      "type": "string",
      "enum": [
        "proportional",
        "window-edges"
      ],
      "default": "proportional"
    },
    "followWindowPosition": {
      "type": "boolean"
    },
    "displayCalibrations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/displayCalibration"
      }
    },
    "sourceRules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/sourceRule"
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "displayCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayId",
        "centerM",
        "widthM",
        "heightM",
        "orientation"
      ],
      "properties": {
        "displayId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 511
        },
        "centerM": {
          "$ref": "#/$defs/vec3"
        },
        "widthM": {
          "type": "number",
          "exclusiveMinimum": 0.1,
          "maximum": 5
        },
        "heightM": {
          "type": "number",
          "exclusiveMinimum": 0.1,
          "maximum": 5
        },
        "orientation": {
          "$ref": "#/$defs/quaternion"
        }
      }
    },
    "sourceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "enabled",
        "gainDb",
        "stereoSpread",
        "fallbackDisplayId"
      ],
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1023
        },
        "enabled": {
          "type": "boolean"
        },
        "gainDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        },
        "stereoSpread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fallbackDisplayId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 511
        }
      }
    }
  }
}
